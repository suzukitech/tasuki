{
	"name": "tasuki",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --watch apps/server/src/index.ts",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit -p .",
		"test": "bun test",
		"check": "bun run lint && bun run typecheck && bun test --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@types/bun": "1.4.5",
		"typescript": "7.0.2"
	}
}
